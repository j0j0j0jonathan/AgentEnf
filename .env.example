# Copy values into your environment. Do not commit credentials.
ENFGUARD_ADMIN_TOKEN=replace-with-a-random-local-token
ENFGUARD_BIN=/absolute/path/to/whyenf/_build/default/bin/enfguard.exe
ENFGUARD_TIME_MODE=wall_seconds
ENFGUARD_YAML=examples/presets/agentic-security.yaml
ENFGUARD_WS_HOST_ROOTS=/absolute/path/to/agent/workspace
ENFGUARD_APPROVAL_MODE=interactive
# ENFGUARD_TOOL_JUDGE=0
# ENFGUARD_TOOL_JUDGE_MODEL=your-classifier-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
